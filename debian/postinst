#!/bin/sh
set -e

case "$1" in
    configure)
        echo "Please restart Nautilus to load the extension:"
        echo "  nautilus -q"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
